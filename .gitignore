# ─── Private working notes ────────────────────────────────────────────────
# Contains the real-name → public-name mapping for employers, vendors and
# internal platforms. This must never reach a public repository: publishing it
# would defeat the anonymization the site itself relies on.
NOTES.private.md

# ─── Private source documents ─────────────────────────────────────────────
# The original résumé, kept as an input artifact. Not needed to build anything.
source/ORIGINAL-*.docx

# ─── Build artifacts ──────────────────────────────────────────────────────
# The DOCX is regenerated by source/build_resume.py on every résumé change.
site/resume/*.docx
!site/resume/Duke-Morgan-Resume.docx
!site/resume/Duke-Morgan-Resume-2026-10-11.docx
!site/resume/Duke-Morgan-Resume-2026-09-25.docx

# ─── Local tooling caches ─────────────────────────────────────────────────
.impeccable/
.claude/

# ─── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ─── OS noise ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# Current user-supplied resume is the published download.
!site/resume/Duke-Morgan-Resume-2026-09-25.docx
