#!/bin/sh
# Portfolio repo guard. Blocks commits that would leak internal names, private
# files or credential shapes into a public repo. See hooks/scan_staged.py.
#
# Enable once per clone:  git config core.hooksPath hooks
#
# This fails closed on purpose. A guard that silently skips itself is the exact
# failure this hook exists to prevent, so a missing interpreter blocks the
# commit rather than waving it through.

if command -v python >/dev/null 2>&1; then
  PY=python
elif command -v py >/dev/null 2>&1; then
  PY=py
elif command -v python3 >/dev/null 2>&1; then
  PY=python3
else
  echo "pre-commit: no python on PATH, so the leak scan cannot run." >&2
  echo "            Install python, or bypass knowingly: git commit --no-verify" >&2
  exit 1
fi

exec "$PY" "$(git rev-parse --show-toplevel)/hooks/scan_staged.py"
